# Database Configuration
DB_SERVER=your-azure-sql-server.database.windows.net
DB_NAME=ConsumptionViewerDB
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_DRIVER=ODBC Driver 18 for SQL Server

# Microsoft Entra ID Authentication (Optional - for v1.2 authentication)
# If not configured, the app runs in demo mode without authentication
AZURE_CLIENT_ID=your-application-client-id-from-azure-portal
AZURE_TENANT_ID=your-directory-tenant-id-from-azure-portal
AZURE_CLIENT_SECRET=your-client-secret-from-azure-portal

# Optional: Custom redirect URI for OAuth flow
REDIRECT_URI=http://localhost:8501

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10

# Session Configuration
SESSION_SECRET_KEY=change-this-to-a-random-secret-key
